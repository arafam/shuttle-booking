generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id              String   @id @default(cuid())
  route           String
  pickupLocation  String
  dropoffLocation String
  cruiseTerminal  String?

  date            String
  time            String

  adults          Int
  childrenUnder5  Int

  customerName    String
  email           String
  phone           String

  notes           String?

  totalPrice      Float

  status          String   @default("pending")
  createdAt       DateTime @default(now())

  @@index([date])
  @@index([status])
}